PORT=8080
DATABASE_URL=postgres://user:pass@host:5432/sphere?sslmode=disable
JWT_SECRET=change-me-to-random-secret

# Outgoing email (Resend) — use an address on your verified domain
MAIL_FROM=Sphere <noreply@spheremusic.space>
RESEND_API_KEY=
SIGNUP_LOG_CODE=false

# reCAPTCHA v3: https://developers.google.com/recaptcha/docs/v3
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

GOOGLE_CLIENT_ID=

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sphere-uploads

# Spotify Developer Dashboard (developer.spotify.com) — NOT SoundCloud keys.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional full-track playback (go-librespot state, base64):
SPOTIFY_CREDS_BLOB=

# SoundCloud app "Sphere" (soundcloud.com/you/apps) — pair must match the same app.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# VK: user OAuth token with audio scope (required for playback URLs)
VK_ACCESS_TOKEN=
# Optional VK app service token (search only; streams need VK_ACCESS_TOKEN)
VK_SERVICE_TOKEN=
# Yandex Music OAuth token from music.yandex.ru session
YANDEX_SERVICE_TOKEN=
# Optional: HMAC sign key override (default is reversed from Android app)
YANDEX_SIGN_KEY=
# Optional: HTTP proxy with RU egress if api.music.yandex.net returns HTTP 451
YANDEX_HTTP_PROXY=

GENIUS_TOKEN=
